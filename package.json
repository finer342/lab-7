{
  "name": "lab7-v8-memory-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Lab 7: V8 internals, memory optimization (ObjectPool, zero-alloc vectors, SpatialHash), Vitest + fast-check + Playwright + GitHub Actions CI",
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite client",
    "build": "tsc -p tsconfig.json && vite build client",
    "typecheck": "tsc --noEmit",
    "lint": "eslint shared server client e2e --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.5",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitest/coverage-v8": "^2.1.2",
    "eslint": "^9.12.0",
    "fast-check": "^3.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
